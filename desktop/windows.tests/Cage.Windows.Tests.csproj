<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WindowsNativeInputTests Condition="'$(WindowsNativeInputTests)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">true</WindowsNativeInputTests>
  </PropertyGroup>
  <PropertyGroup Condition="'$(WindowsNativeInputTests)' == 'true'">
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../packaging/windows/installation-files.ps1" LogicalName="Cage.InstallationFiles.ps1" />
    <EmbeddedResource Include="../../packaging/windows/verified-file-deletion.cs" LogicalName="Cage.VerifiedFileDeletion.cs" />
    <Compile Include="../windows/UpdatePolicy.cs" Link="UpdatePolicy.cs" />
    <Compile Include="../windows/Backend.cs" Link="Backend.cs" />
    <Compile Include="../windows/NativeHelperLifetime.cs" Link="NativeHelperLifetime.cs" />
    <EmbeddedResource Include="../windows/MainWindow.cs" LogicalName="Cage.MainWindow.Source.cs" />
    <Compile Include="../windows/UpdateRecovery.cs" Link="UpdateRecovery.cs" />
    <Compile Include="../windows/AppUpdater.cs" Link="AppUpdater.cs" />
    <Compile Include="../windows/UpdateInstaller.cs" Link="UpdateInstaller.cs" />
    <Compile Include="../windows/Authenticode.cs" Link="Authenticode.cs" />
    <Compile Include="../windows/WindowLayout.cs" Link="WindowLayout.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(WindowsNativeInputTests)' == 'true'">
    <Compile Include="../windows/NativeInput.cs" Link="NativeInput.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(WindowsNativeInputTests)' != 'true'">
    <Compile Remove="NativeInputTests.cs" />
  </ItemGroup>
</Project>
